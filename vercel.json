{
    "builds": [
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "routes": [
        {
            "src": "^/sw\\.js$",
            "headers": {
                "Cache-Control": "no-cache, no-store, must-revalidate",
                "Service-Worker-Allowed": "/"
            },
            "continue": true
        },
        {
            "src": "^/(index\\.html)?$",
            "headers": {
                "Cache-Control": "no-cache, no-store, must-revalidate"
            },
            "continue": true
        },
        {
            "src": "^/assets/(.*)$",
            "headers": {
                "Cache-Control": "public, max-age=31536000, immutable"
            },
            "continue": true
        },
        {
            "src": "^/s/p/(\\d+)/?$",
            "dest": "https://api.smartbizcoach.com.ng/api/marketplace/share/p/$1/"
        },
        {
            "src": "^/s/u/([^/]+)/?$",
            "dest": "https://api.smartbizcoach.com.ng/api/marketplace/share/u/$1/"
        },
        {
            "src": "^/sitemap-market\\.xml$",
            "dest": "https://api.smartbizcoach.com.ng/api/marketplace/sitemap-market.xml"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}
